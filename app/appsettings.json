{
  "database": {
    "url": "sqlite:///./fero_jobs.db"
  },
  "worker": {
    "poll_interval_seconds": 1,
    "http_timeout_seconds": 10,
    "lease_duration_seconds": 60
  },
  "retry": {
    "max_attempts": 5,
    "initial_delay_seconds": 2,
    "backoff_multiplier": 2,
    "max_delay_seconds": 60,
    "retryable_status_codes": [429, 500, 503]
  },
  "app": {
    "name": "FERO Platform",
    "debug": false
  }
}
