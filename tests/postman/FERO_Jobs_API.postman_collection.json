              "pm.test('Valid job UUID', function () {",
              "    pm.expect(data.id).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "pm.test('Initial status pending', function () {",
              "    pm.expect(data.status).to.eql('pending');",
              "});",
              "",
              "if (pm.response.code === 201 && data.id) {",
              "    pm.collectionVariables.set('scenario6_id', data.id);",
              "    pm.collectionVariables.set('scenario6_polls', '0');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06B - Verify - HTTPBin - HTTP 503",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jobs/{{scenario6_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const expectedStatus = 'dead';",
              "const expectedAttempts = 5;",
              "const jobId = pm.collectionVariables.get('scenario6_id');",
              "const startedKey = 'scenario6_started';",
              "const started = Number(pm.collectionVariables.get(startedKey) || Date.now());",
              "",
              "pm.collectionVariables.set(startedKey, String(started));",
              "",
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Correct job ID', function () {",
              "    pm.expect(data.id).to.eql(jobId);",
              "});",
              "",
              "pm.test('Valid job structure and attempt count', function () {",
              "    pm.expect(Object.keys(data).sort()).to.eql(",
              "        ['attempts', 'id', 'next_retry_at', 'status']",
              "    );",
              "    pm.expect(data.attempts).to.be.within(0, expectedAttempts);",
              "});",
              "",
              "const finished = ['completed', 'failed', 'dead'].includes(data.status);",
              "const elapsed = Date.now() - started;",
              "const timeoutMs = 180000;",
              "",
              "if (finished) {",
              "    pm.test('Expected final status', function () {",
              "        pm.expect(data.status).to.eql(expectedStatus);",
              "    });",
              "",
              "    pm.test('Expected final attempt count', function () {",
              "        pm.expect(data.attempts).to.eql(expectedAttempts);",
              "    });",
              "",
              "    pm.test('No retry after terminal status', function () {",
              "        pm.expect(data.next_retry_at).to.be.null;",
              "    });",
              "",
              "    pm.collectionVariables.unset(startedKey);",
              "",
              "} else if (elapsed >= timeoutMs) {",
              "    pm.test('Job finished within 180 seconds', function () {",
              "        pm.expect.fail(",
              "            'Timeout: status=' + data.status +",
              "            ', attempts=' + data.attempts",
              "        );",
              "    });",
              "",
              "    pm.collectionVariables.unset(startedKey);",
              "",
              "} else {",
              "    pm.test('Job is awaiting processing or retry', function () {",
              "        pm.expect(['pending', 'running']).to.include(data.status);",
              "    });",
              "",
              "    // The sandbox waits for the timer before proceeding to the next request.",
              "    pm.execution.setNextRequest('06B - Verify - HTTPBin - HTTP 503');",
              "    setTimeout(function () {}, 1500);",
              "}"
            ]
          }
        }
      ]
    },
